# Python 虚拟环境
.venv/
__pycache__/

# 数据文件 (绝对不能传)
*.csv
*.npy
*.pkl
data/

# The daily forecast store IS committed — it is the site's data and must persist across the
# ephemeral CI runners. Re-allow it past the blanket *.csv / data/ ignores above.
!/web/
!/web/*.csv

# 模型权重和结果
/models/
/results/

# Serving bundle — built by bundle_serving.sh and uploaded to a GitHub Release, never committed
# (the CI job downloads it from the release; a copy in the repo would block that download).
serving_bundle.tar.gz

# 日志文件
logs/
*.out
*.err