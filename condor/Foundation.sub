# STAGE 2 sibling — zero-shot TimesFM, one job per (target, zone, arm, mode). 40 jobs.
# Trains nothing; it only needs the matrices, so it runs alongside Train.sub rather than after.

universe    = vanilla
# PORTABLE ON PURPOSE. `initialdir` is the job's working directory on the execute
# node, and hard-coding one user's path means anyone else's clone submits jobs that
# chdir into THAT user's tree and write models/ and results/ there. Omitting it makes
# condor_submit resolve it to wherever it was run from, and a relative executable is
# resolved against the same place and stored as an absolute path in the job ad.
# So: always run condor_submit from the project root.
executable  = condor/foundation_one.sh

request_cpus   = 4
request_memory = 8G
# 1G, not the 20G this used to ask for. Measured DiskUsage is 2 KB: with
# should_transfer_files = NO the job works directly on the NFS project and leaves the
# execute node's scratch empty. The oversized request was a pure filter — on its own it
# cut the matching slots from 235 to 53 and held the run to ~22 concurrent.
request_disk   = 1G

# HF_HOME on the shared filesystem: the checkpoint is fetched ONCE on the submit host and all
# forty jobs read that copy. $HOME would work too, but a ~1 GB blob does not belong in a
# backed-up home quota.
environment = "PJM_TARGET=$(TARGET) PJM_DATASET=$(ZONE) PJM_CONGESTION=$(CONG) PJM_LMP=$(LMP) PJM_FMODE=$(FMODE) HF_HOME=$ENV(HOME)/hf_cache OMP_NUM_THREADS=4"
getenv      = False

should_transfer_files = NO

output = logs/timesfm.$(TARGET)_$(ZONE)_c$(CONG)_l$(LMP)_$(FMODE).$(Cluster).out
error  = logs/timesfm.$(TARGET)_$(ZONE)_c$(CONG)_l$(LMP)_$(FMODE).$(Cluster).err
log    = logs/timesfm.$(Cluster).log

max_retries = 1

queue TARGET, ZONE, CONG, LMP, FMODE from condor/jobs_foundation.txt
